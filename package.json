{
  "name": "tokflow",
  "version": "0.1.0",
  "description": "Aplikasi desktop Windows yang ringan, aman, dan rapi untuk streamer TikTok Live",
  "author": "TokFlow Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/REPO.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-overlay.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src tests",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "dist": "npm run build && electron-builder --win",
    "smoke": "node scripts/smoke-test.mjs",
    "licenses": "node scripts/generate-licenses.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.1.2",
    "lucide-preact": "^1.16.0",
    "preact": "^10.26.0",
    "tiktok-live-connector": "2.5.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@preact/preset-vite": "^2.9.5",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "electron": "^34.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.19.0",
    "playwright": "^1.50.1",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
